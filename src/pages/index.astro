---
import Layout from "../layouts/Layout.astro";
import { config } from "../config";
import Hero from "../components/Hero.astro";
import PhotoSwipeGallery from "../components/PhotoSwipeGallery.astro";
---

<Layout
    title="Colorado Custom Home Builders | Denver House Builder | Q Builders"
    description="Colorado custom home builders specializing in Denver house construction. 75+ homes built across the front range since 2014. Custom home builder Denver: expert craftsmanship, transparent pricing."
>
    <nav
        id="navbar"
        class="fixed top-0 left-0 right-0 z-50 transition-all duration-[var(--transition-medium)] transform -translate-y-full"
        aria-label="Main navigation"
    >
        <div
            class="w-full px-4 py-3 md:px-8 md:py-4 flex justify-between items-center"
        >
            <a
                href="#hero"
                class="hidden md:flex items-center gap-3 hover:opacity-80 transition-opacity"
                aria-label="Q Builders"
            >
                <img src="/logo.svg" alt="Q Builders" class="h-12 w-auto" />
            </a>
            <div
                class="flex items-center justify-around w-full md:justify-end md:w-auto gap-1 md:gap-2"
            >
                {
                    [
                        "about",
                        "owner",
                        "gallery",
                        ...(config.testimonials.length > 0
                            ? ["testimonials"]
                            : []),
                    ].map((section) => (
                        <a
                            href={`#${section}`}
                            class="nav-link px-3 py-2 md:px-4 md:py-2 text-[var(--color-on-surface-variant)] hover:text-[var(--color-primary)] text-xs md:text-sm font-semibold uppercase tracking-[0.1em] transition-all rounded hover:bg-[var(--color-secondary-container)]/25"
                            aria-label={`Navigate to ${section}`}
                        >
                            {section.charAt(0).toUpperCase() + section.slice(1)}
                        </a>
                    ))
                }
                <a
                    href="/portfolio"
                    class="nav-link px-3 py-2 md:px-4 md:py-2 text-[var(--color-on-surface-variant)] hover:text-[var(--color-primary)] text-xs md:text-sm font-semibold uppercase tracking-[0.1em] transition-all rounded hover:bg-[var(--color-secondary-container)]/25"
                    aria-label="View portfolio"
                >
                    Portfolio
                </a>
                <a
                    href="#contact"
                    class="nav-link px-3 py-2 md:px-4 md:py-2 text-[var(--color-on-surface-variant)] hover:text-[var(--color-primary)] text-xs md:text-sm font-semibold uppercase tracking-[0.1em] transition-all rounded hover:bg-[var(--color-secondary-container)]/25"
                    aria-label="Navigate to contact"
                >
                    Contact
                </a>
            </div>
        </div>
    </nav>

    <main class="scroll-smooth overflow-y-scroll overflow-x-hidden">
        <Hero />

        <section
            id="about"
            class="relative py-20 md:py-32 px-6"
            aria-labelledby="about-heading"
        >
            <div class="max-w-7xl mx-auto">
                <div class="card p-8 md:p-16">
                    <div
                        class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-center"
                    >
                        <div class="order-2 lg:order-1">
                            <h2
                                id="about-heading"
                                class="text-4xl md:text-5xl lg:text-6xl text-[var(--color-primary)] mb-8 leading-[1.1]"
                            >
                                About Us
                            </h2>
                            <p
                                class="text-lg text-[var(--color-on-surface-variant)] leading-relaxed whitespace-pre-line"
                            >
                                {config.about.bio}
                            </p>
                        </div>
                        <div
                            class="relative order-1 lg:order-2 h-[320px] md:h-[450px]"
                        >
                            <div
                                class="absolute -inset-4 border border-[var(--color-brass)]/30 rounded-lg opacity-70"
                            >
                            </div>
                            {
                                config.portfolio.map((home, index) => (
                                    <img
                                        src={home.image.src}
                                        alt={home.image.alt}
                                        class={`about-gallery-image absolute inset-0 w-full h-full object-cover rounded-lg transition-opacity duration-[1500ms] ease-in-out ${index === 0 ? "opacity-100" : "opacity-0"}`}
                                        data-index={index}
                                        loading="lazy"
                                    />
                                ))
                            }
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section
            id="owner"
            class="relative py-20 md:py-32 px-6"
            aria-labelledby="owner-heading"
        >
            <div class="max-w-7xl mx-auto">
                <div class="card p-8 md:p-16">
                    <div
                        class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-center"
                    >
                        <div class="relative group">
                            <div
                                class="absolute -inset-4 border border-[var(--color-brass)]/30 rounded-lg opacity-70"
                            >
                            </div>
                            <div class="relative overflow-hidden rounded-lg">
                                <picture class="block">
                                    <source
                                        srcset={config.owner.photo}
                                        type="image/jpeg"
                                    />
                                    <img
                                        src={config.owner.photo}
                                        alt={config.owner.name}
                                        class="w-full h-[320px] md:h-[450px] object-cover object-[50%_30%] transition-transform duration-700 group-hover:scale-105"
                                        loading="lazy"
                                    />
                                </picture>
                                <div
                                    class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"
                                >
                                </div>
                                <div class="absolute bottom-6 left-6 right-6">
                                    <h3
                                        class="text-2xl md:text-3xl text-white font-medium mb-1"
                                    >
                                        {config.owner.name}
                                    </h3>
                                    <p
                                        class="text-[var(--color-accent)] text-sm font-semibold uppercase tracking-[0.1em]"
                                    >
                                        {config.owner.title}
                                    </p>
                                </div>
                            </div>
                        </div>
                        <div>
                            <h2
                                id="owner-heading"
                                class="text-4xl md:text-5xl lg:text-6xl text-[var(--color-primary)] mb-8 leading-[1.1]"
                            >
                                About the Owner
                            </h2>
                            <p
                                class="text-lg text-[var(--color-on-surface-variant)] leading-relaxed whitespace-pre-line"
                            >
                                {config.owner.bio}
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section
            id="gallery"
            class="relative py-24 md:py-40 px-6"
            aria-labelledby="gallery-heading"
        >
            <div class="relative z-10 max-w-7xl mx-auto">
                <div class="text-center mb-16 md:mb-20">
                    <h2
                        id="gallery-heading"
                        class="text-4xl md:text-5xl lg:text-6xl text-white"
                    >
                        Gallery
                    </h2>
                </div>

                <div
                    class="md:hidden -mx-6 overflow-x-auto px-6 pb-4 gallery-mobile-scroll"
                    data-pswp-gallery
                >
                    <div class="flex gap-4 pr-6 snap-x snap-mandatory">
                        {
                            config.gallery.map((image, index) => (
                                <figure class="group relative w-[78vw] max-w-[23rem] shrink-0 snap-start overflow-hidden rounded-lg bg-[var(--color-surface-container-lowest)] ring-1 ring-[var(--color-brass)]/35">
                                    <a
                                        href={image.src}
                                        data-pswp-item
                                        data-pswp-width={image.width}
                                        data-pswp-height={image.height}
                                        aria-label={`Open gallery image ${index + 1}: ${image.alt}`}
                                        class="block aspect-[5/4] w-full overflow-hidden rounded-[inherit]"
                                    >
                                        <picture class="block h-full w-full overflow-hidden rounded-[inherit]">
                                            <source
                                                srcset={image.src}
                                                type="image/jpeg"
                                            />
                                            <img
                                                src={image.src}
                                                alt={image.alt}
                                                loading="lazy"
                                                class="h-full w-full rounded-[inherit] object-cover transition-transform duration-500 group-hover:scale-[1.03]"
                                            />
                                        </picture>
                                    </a>
                                </figure>
                            ))
                        }
                    </div>
                </div>

                <div class="hidden md:block" data-pswp-gallery>
                    <div class="columns-3 gap-5 space-y-5">
                        {
                            config.gallery.map((image, index) => {
                                const isPortrait = image.height > image.width;
                                const aspectRatio = isPortrait
                                    ? "aspect-[3/4]"
                                    : "aspect-[4/3]";

                                return (
                                    <figure
                                        class={`group relative overflow-hidden rounded-lg break-inside-avoid ${aspectRatio} transition-all duration-300 ring-1 ring-[var(--color-brass)]/25 hover:ring-[var(--color-brass)]`}
                                    >
                                        <a
                                            href={image.src}
                                            data-pswp-item
                                            data-pswp-width={image.width}
                                            data-pswp-height={image.height}
                                            aria-label={`Open gallery image ${index + 1}: ${image.alt}`}
                                            class="block w-full h-full cursor-pointer"
                                        >
                                            <picture class="block w-full h-full">
                                                <source
                                                    srcset={image.src}
                                                    type="image/jpeg"
                                                />
                                                <img
                                                    src={image.src}
                                                    alt={image.alt}
                                                    loading="lazy"
                                                    class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                                                />
                                            </picture>
                                            <div class="absolute inset-0 bg-black/0 group-hover:bg-black/20 transition-colors duration-300" />
                                            <div class="absolute bottom-3 right-3 opacity-0 group-hover:opacity-100 transition-all duration-300">
                                                <div class="w-8 h-8 rounded-full bg-white/20 backdrop-blur-sm flex items-center justify-center">
                                                    <svg
                                                        class="w-4 h-4 text-white"
                                                        fill="none"
                                                        stroke="currentColor"
                                                        viewBox="0 0 24 24"
                                                    >
                                                        <path
                                                            stroke-linecap="round"
                                                            stroke-linejoin="round"
                                                            stroke-width="2"
                                                            d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7"
                                                        />
                                                    </svg>
                                                </div>
                                            </div>
                                        </a>
                                    </figure>
                                );
                            })
                        }
                    </div>
                </div>

                <div class="mt-14 text-center">
                    <a
                        href="/portfolio"
                        class="btn-secondary border-white bg-white text-[var(--color-primary)] shadow-2xl shadow-black/25 hover:bg-[var(--color-secondary-container)] hover:text-[var(--color-primary)]"
                        aria-label="See the full Q Builders portfolio"
                    >
                        <span>See full portfolio</span>
                        <svg
                            class="h-5 w-5"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                            aria-hidden="true"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
                        </svg>
                    </a>
                </div>

                <PhotoSwipeGallery />
            </div>
        </section>

        {
            config.testimonials.length > 0 && (
                <section
                    id="testimonials"
                    class="relative py-24 md:py-40 px-6"
                    aria-labelledby="testimonials-heading"
                >
                    <div class="max-w-7xl mx-auto">
                        <div class="text-center mb-16 md:mb-20">
                            <h2
                                id="testimonials-heading"
                                class="text-4xl md:text-5xl lg:text-6xl text-[var(--color-primary)]"
                            >
                                Testimonials
                            </h2>
                        </div>
                        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
                            {config.testimonials.map((testimonial, index) => (
                                <figure
                                    class={`card p-8 ${index === 0 ? "md:col-span-2 lg:col-span-1" : ""}`}
                                >
                                    <div class="text-[var(--color-accent)] text-5xl leading-none mb-4 opacity-50">
                                        "
                                    </div>
                                    <blockquote class="text-[var(--color-on-surface-variant)] leading-relaxed mb-8 text-lg">
                                        {testimonial.quote}
                                    </blockquote>
                                    <figcaption class="flex items-center gap-4 pt-6 border-t border-[var(--color-outline-variant)]">
                                        <div class="w-12 h-12 rounded-full bg-[var(--color-secondary-container)] flex items-center justify-center">
                                            <span class="text-[var(--color-accent)] font-medium text-lg">
                                                {testimonial.name.charAt(0)}
                                            </span>
                                        </div>
                                        <div>
                                            <div class="text-[var(--color-on-surface)] font-semibold mb-0.5">
                                                {testimonial.name}
                                            </div>
                                            <div class="text-[var(--color-warm-gray)] text-sm">
                                                {testimonial.neighborhood}
                                            </div>
                                        </div>
                                    </figcaption>
                                </figure>
                            ))}
                        </div>
                    </div>
                </section>
            )
        }

        <section
            id="contact"
            class="relative py-32 md:py-48 px-6"
            aria-labelledby="contact-heading"
        >
            <div
                class="card relative z-10 max-w-4xl mx-auto text-center p-8 md:p-16"
            >
                <h2
                    id="contact-heading"
                    class="text-4xl md:text-5xl lg:text-6xl text-[var(--color-primary)] mb-6"
                >
                    {config.contact.headline}
                </h2>
                <p
                    class="text-lg md:text-xl text-[var(--color-on-surface-variant)] mb-12 leading-relaxed max-w-2xl mx-auto"
                >
                    {config.contact.description}
                </p>
                <div
                    class="flex flex-col sm:flex-row items-center justify-center gap-3"
                >
                    <a
                        href={`mailto:${config.hero.email}`}
                        class="btn-primary text-base px-6 py-4 group"
                        aria-label={`Send email to ${config.hero.email}`}
                    >
                        <svg
                            class="w-5 h-5"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                            aria-hidden="true"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                            ></path>
                        </svg>
                        <span>Email</span>
                    </a>
                    <button
                        id="copy-email-btn"
                        class="btn-secondary text-base px-6 py-4 group"
                        aria-label={`Copy ${config.hero.email} to clipboard`}
                        data-email={config.hero.email}
                    >
                        <svg
                            id="copy-icon"
                            class="w-5 h-5 transition-transform group-hover:scale-110"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                            aria-hidden="true"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"
                            ></path>
                        </svg>
                        <svg
                            id="check-icon"
                            class="w-5 h-5 hidden text-[var(--color-primary-container)]"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                            aria-hidden="true"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M5 13l4 4L19 7"></path>
                        </svg>
                        <span id="copy-text">Copy</span>
                    </button>
                </div>
                <p
                    class="mt-6 text-[var(--color-primary)] text-lg md:text-xl font-semibold"
                >
                    {config.hero.email}
                </p>
            </div>
        </section>
    </main>

    <script>
        const navbar = document.getElementById("navbar");
        const sections = document.querySelectorAll(
            "section[id]",
        ) as NodeListOf<HTMLElement>;
        const navLinks = document.querySelectorAll(".nav-link");
        let ticking = false;

        const updateUI = () => {
            const scrollY = window.scrollY || window.pageYOffset;

            if (navbar) {
                if (scrollY > 100) {
                    navbar.classList.remove("-translate-y-full");
                    navbar.classList.add(
                        "translate-y-0",
                        "bg-[var(--color-surface)]/95",
                        "backdrop-blur-[var(--backdrop-blur)]",
                        "border-b",
                        "border-[var(--color-outline-variant)]",
                    );
                } else {
                    navbar.classList.add("-translate-y-full");
                    navbar.classList.remove(
                        "translate-y-0",
                        "bg-[var(--color-surface)]/95",
                        "backdrop-blur-[var(--backdrop-blur)]",
                        "border-b",
                        "border-[var(--color-outline-variant)]",
                    );
                }
            }

            if (sections.length && navLinks.length) {
                sections.forEach((section) => {
                    const sectionTop = section.offsetTop;
                    const sectionHeight = section.offsetHeight;
                    const sectionId = section.getAttribute("id");

                    if (
                        sectionId &&
                        scrollY >= sectionTop - 300 &&
                        scrollY < sectionTop + sectionHeight - 300
                    ) {
                        navLinks.forEach((link) => {
                            if (link.getAttribute("href") === `#${sectionId}`) {
                                link.classList.add(
                                    "text-[var(--color-primary)]",
                                );
                            } else {
                                link.classList.remove(
                                    "text-[var(--color-primary)]",
                                );
                            }
                        });
                    }
                });
            }

            ticking = false;
        };

        const onScroll = () => {
            if (!ticking) {
                window.requestAnimationFrame(updateUI);
                ticking = true;
            }
        };

        document.addEventListener("DOMContentLoaded", () => {
            window.addEventListener("scroll", onScroll, { passive: true });

            // Copy email functionality
            const copyBtn = document.getElementById("copy-email-btn");
            const copyIcon = document.getElementById("copy-icon");
            const checkIcon = document.getElementById("check-icon");
            const copyText = document.getElementById("copy-text");

            if (copyBtn && copyIcon && checkIcon && copyText) {
                copyBtn.addEventListener("click", async () => {
                    const email = copyBtn.getAttribute("data-email");
                    if (email) {
                        try {
                            await navigator.clipboard.writeText(email);
                            copyIcon.classList.add("hidden");
                            checkIcon.classList.remove("hidden");
                            copyText.textContent = "Copied!";

                            setTimeout(() => {
                                copyIcon.classList.remove("hidden");
                                checkIcon.classList.add("hidden");
                                copyText.textContent = "Copy";
                            }, 2000);
                        } catch (err) {
                            console.error("Failed to copy:", err);
                        }
                    }
                });
            }

            const aboutImages = document.querySelectorAll(
                ".about-gallery-image",
            );

            if (aboutImages.length > 0) {
                let currentIndex = 0;
                const interval = 8000;

                setInterval(() => {
                    aboutImages[currentIndex].classList.remove("opacity-100");
                    aboutImages[currentIndex].classList.add("opacity-0");

                    currentIndex = (currentIndex + 1) % aboutImages.length;

                    aboutImages[currentIndex].classList.remove("opacity-0");
                    aboutImages[currentIndex].classList.add("opacity-100");
                }, interval);
            }
        });
    </script>
</Layout>
