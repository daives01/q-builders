---
import Layout from "../layouts/Layout.astro";
import { config } from "../config";

const featured = config.portfolio[0];
const dreamHomeCta = {
    kind: "cta" as const,
    title: "Your Dream Home",
    image: {
        src: "/portfolio/dream-home.webp",
        alt: "A bright custom home concept ready to become a client's dream home",
    },
};
const portfolioItems = [
    ...config.portfolio.map((home) => ({ kind: "home" as const, ...home })),
    dreamHomeCta,
];
const spreads = portfolioItems.reduce<(typeof portfolioItems)[]>(
    (groups, item, index) => {
        if (index % 2 === 0) groups.push([item]);
        else groups[groups.length - 1].push(item);
        return groups;
    },
    [],
);
---

<Layout
    title="Portfolio | Completed Denver Custom Homes | Q Builders"
    description="A focused portfolio of completed Denver-area homes by Q Builders."
    image={featured.image.src}
>
    <nav
        class="site-nav fixed left-0 right-0 top-0 z-50 flex min-w-0 items-center justify-between gap-3 bg-[var(--color-surface)] px-4 py-3 md:gap-4 md:px-8 md:py-4"
        aria-label="Main navigation"
    >
        <details class="nav-menu relative order-1 md:hidden">
            <summary
                class="flex h-11 w-11 cursor-pointer list-none items-center justify-center rounded-[var(--radius-md)] border-0 text-[var(--color-primary)] transition-colors hover:text-[var(--color-brass-dark)]"
                aria-label="Open navigation menu"
            >
                <svg
                    class="h-8 w-8"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    aria-hidden="true"
                >
                    <path d="M4 7h16"></path>
                    <path d="M4 12h16"></path>
                    <path d="M4 17h16"></path>
                </svg>
            </summary>
            <div
                class="fixed left-0 right-0 top-[4.25rem] grid overflow-hidden border-0 bg-[var(--color-surface)]/98 text-left shadow-[0_18px_45px_-28px_rgba(0,0,0,0.55)] backdrop-blur-[var(--backdrop-blur)]"
            >
                <a
                    href="/#about"
                    class="border-t border-[var(--color-outline-variant)]/60 px-4 py-4 text-sm font-semibold uppercase tracking-[0.1em] text-[var(--color-on-surface-variant)] transition-colors first:border-t-0 hover:text-[var(--color-primary)]"
                >
                    About
                </a>
                <a
                    href="/#owner"
                    class="border-t border-[var(--color-outline-variant)]/60 px-4 py-4 text-sm font-semibold uppercase tracking-[0.1em] text-[var(--color-on-surface-variant)] transition-colors hover:text-[var(--color-primary)]"
                >
                    Owner
                </a>
                <a
                    href="/#gallery"
                    class="border-t border-[var(--color-outline-variant)]/60 px-4 py-4 text-sm font-semibold uppercase tracking-[0.1em] text-[var(--color-on-surface-variant)] transition-colors hover:text-[var(--color-primary)]"
                >
                    Gallery
                </a>
                <a
                    href="/portfolio"
                    aria-current="page"
                    class="border-t border-[var(--color-outline-variant)]/60 px-4 py-4 text-sm font-semibold uppercase tracking-[0.1em] text-[var(--color-primary)] transition-colors"
                >
                    Portfolio
                </a>
                <a
                    href="/#contact"
                    class="border-t border-[var(--color-outline-variant)]/60 px-4 py-4 text-sm font-semibold uppercase tracking-[0.1em] text-[var(--color-on-surface-variant)] transition-colors hover:text-[var(--color-primary)]"
                >
                    Contact
                </a>
            </div>
        </details>
        <a
            href="/"
            class="order-2 flex items-center gap-3 transition-opacity hover:opacity-80 md:order-none"
            aria-label="Q Builders home"
        >
            <img src="/logo.svg" alt="Q Builders" class="h-10 w-auto md:h-12" />
        </a>
        <div class="hidden items-center gap-2 md:flex">
            <a
                href="/#about"
                class="px-4 py-2 text-sm font-semibold uppercase tracking-[0.1em] text-[var(--color-on-surface-variant)] transition-colors hover:text-[var(--color-primary)]"
            >
                About
            </a>
            <a
                href="/#owner"
                class="px-4 py-2 text-sm font-semibold uppercase tracking-[0.1em] text-[var(--color-on-surface-variant)] transition-colors hover:text-[var(--color-primary)]"
            >
                Owner
            </a>
            <a
                href="/#gallery"
                class="px-4 py-2 text-sm font-semibold uppercase tracking-[0.1em] text-[var(--color-on-surface-variant)] transition-colors hover:text-[var(--color-primary)]"
            >
                Gallery
            </a>
            <a
                href="/portfolio"
                aria-current="page"
                class="px-4 py-2 text-sm font-semibold uppercase tracking-[0.1em] text-[var(--color-primary)]"
            >
                Portfolio
            </a>
            <a
                href="/#contact"
                class="px-4 py-2 text-sm font-semibold uppercase tracking-[0.1em] text-[var(--color-on-surface-variant)] transition-colors hover:text-[var(--color-primary)]"
            >
                Contact
            </a>
        </div>
    </nav>

    <script is:inline>
        document.body.classList.add("site-nav-visible");
    </script>

    <main
        class="min-h-screen bg-[var(--color-surface)] px-4 pb-10 pt-24 text-[var(--color-on-surface)] md:px-8 md:pb-14 md:pt-28"
    >
        <section
            class="mx-auto flex min-h-[calc(100vh-9rem)] max-w-[104rem] flex-col justify-center"
            aria-labelledby="portfolio-heading"
        >
            <header class="mx-auto mb-5 w-full max-w-7xl px-1 md:mb-7">
                <h1
                    id="portfolio-heading"
                    class="text-3xl leading-none text-[var(--color-primary)] md:text-5xl"
                >
                    Portfolio
                </h1>
            </header>

            <div class="relative mx-auto hidden w-full max-w-7xl lg:block">
                <button
                    class="absolute left-4 top-1/2 z-10 hidden h-12 w-12 -translate-y-1/2 items-center justify-center rounded-full border border-black/25 bg-white/90 text-black shadow-[0_12px_30px_-18px_rgba(0,0,0,0.55)] transition hover:scale-[1.04] hover:bg-white min-[900px]:flex min-[1480px]:-left-16"
                    type="button"
                    aria-label="Previous portfolio spread"
                    data-carousel-prev
                >
                    <svg
                        class="h-5 w-5"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        aria-hidden="true"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M15 19l-7-7 7-7"></path>
                    </svg>
                </button>

                <div
                    class="relative mx-auto overflow-hidden bg-white shadow-[0_24px_70px_-38px_rgba(0,0,0,0.45)] ring-1 ring-black/10"
                >
                    <div
                        class="flex transition-transform duration-500 ease-out"
                        data-carousel-track
                    >
                        {
                            spreads.map((spread, spreadIndex) => (
                                <div class="grid min-w-full grid-cols-2">
                                    {spread.map((item, homeIndex) => (
                                        <article
                                            class={`relative flex min-h-[37rem] flex-col bg-white p-6 lg:p-8 ${homeIndex === 0 ? "border-r border-black/15" : ""}`}
                                        >
                                            <img
                                                class="aspect-[1.18/1] w-full rounded-[var(--radius-sm)] bg-[var(--color-surface-container)] object-cover"
                                                src={item.image.src}
                                                alt={item.image.alt}
                                                data-carousel-image
                                                data-spread-index={spreadIndex}
                                                loading={
                                                    spreadIndex === 0
                                                        ? "eager"
                                                        : "lazy"
                                                }
                                                fetchpriority={
                                                    spreadIndex === 0
                                                        ? "high"
                                                        : "auto"
                                                }
                                            />
                                            {item.kind === "home" ? (
                                                <>
                                                    <div class="mt-6 border-b border-black/65 pb-4 md:mt-8">
                                                        <p class="text-[0.7rem] font-bold uppercase tracking-[0.13em] text-black">
                                                            {item.neighborhood}
                                                        </p>
                                                        <h2 class="mt-2 text-[2rem] font-light leading-none text-black md:text-[2.7rem]">
                                                            {item.title}
                                                        </h2>
                                                    </div>
                                                    <dl class="mt-4 grid grid-cols-4 divide-x divide-black/35">
                                                        {item.stats
                                                            .slice(0, 4)
                                                            .map((stat) => (
                                                                <div class="min-w-0 px-2 text-center first:pl-0 last:pr-0">
                                                                    <dd class="min-h-[2rem] [overflow-wrap:anywhere] text-[1.25rem] font-light leading-none text-black md:text-[2rem]">
                                                                        {stat.value}
                                                                    </dd>
                                                                    <dt class="mx-auto mt-2 max-w-[5.5rem] text-[0.5rem] font-bold uppercase leading-tight text-black/85 md:text-[0.52rem]">
                                                                        {stat.label}
                                                                    </dt>
                                                                </div>
                                                            ))}
                                                    </dl>
                                                </>
                                            ) : (
                                                <>
                                                    <div class="mt-6 border-b border-black/65 pb-4 md:mt-8">
                                                        <p class="text-[0.7rem] font-bold uppercase tracking-[0.13em] text-black">
                                                            Start Your Project
                                                        </p>
                                                        <h2 class="mt-2 text-[2rem] font-light leading-none text-black md:text-[2.7rem]">
                                                            {item.title}
                                                        </h2>
                                                    </div>
                                                    <div class="mt-4 flex min-h-[4.6rem] flex-col items-start gap-3">
                                                        <p class="min-w-0 text-lg font-semibold leading-tight text-[var(--color-primary)]">
                                                            {config.hero.email}
                                                        </p>
                                                        <div class="flex flex-wrap gap-3">
                                                            <a
                                                                href={`mailto:${config.hero.email}`}
                                                                class="btn-primary min-w-[7.5rem] justify-center px-4 py-3 text-sm"
                                                                aria-label={`Send email to ${config.hero.email}`}
                                                            >
                                                                <svg
                                                                    class="h-4 w-4"
                                                                    fill="none"
                                                                    stroke="currentColor"
                                                                    viewBox="0 0 24 24"
                                                                    aria-hidden="true"
                                                                >
                                                                    <path
                                                                        stroke-linecap="round"
                                                                        stroke-linejoin="round"
                                                                        stroke-width="2"
                                                                        d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                                                                    />
                                                                </svg>
                                                                <span>Email</span>
                                                            </a>
                                                            <button
                                                                class="btn-secondary min-w-[7.5rem] justify-center px-4 py-3 text-sm"
                                                                type="button"
                                                                aria-label={`Copy ${config.hero.email} to clipboard`}
                                                                data-copy-email={config.hero.email}
                                                            >
                                                                <span data-copy-default class="inline-flex items-center gap-2">
                                                                    <svg
                                                                        class="h-4 w-4"
                                                                        fill="none"
                                                                        stroke="currentColor"
                                                                        viewBox="0 0 24 24"
                                                                        aria-hidden="true"
                                                                    >
                                                                        <path
                                                                            stroke-linecap="round"
                                                                            stroke-linejoin="round"
                                                                            stroke-width="2"
                                                                            d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"
                                                                        />
                                                                    </svg>
                                                                    <span>Copy</span>
                                                                </span>
                                                                <span data-copy-success hidden class="inline-flex items-center gap-2">
                                                                    <svg
                                                                        class="h-4 w-4 text-[var(--color-primary-container)]"
                                                                        fill="none"
                                                                        stroke="currentColor"
                                                                        viewBox="0 0 24 24"
                                                                        aria-hidden="true"
                                                                    >
                                                                        <path
                                                                            stroke-linecap="round"
                                                                            stroke-linejoin="round"
                                                                            stroke-width="2"
                                                                            d="M5 13l4 4L19 7"
                                                                        />
                                                                    </svg>
                                                                    <span>Copied</span>
                                                                </span>
                                                            </button>
                                                        </div>
                                                    </div>
                                                </>
                                            )}
                                        </article>
                                    ))}
                                    {spread.length === 1 && (
                                        <div
                                            class="min-h-[37rem] bg-white"
                                            aria-hidden="true"
                                        />
                                    )}
                                </div>
                            ))
                        }
                    </div>
                </div>

                <button
                    class="absolute right-4 top-1/2 z-10 hidden h-12 w-12 -translate-y-1/2 items-center justify-center rounded-full border border-black/25 bg-white/90 text-black shadow-[0_12px_30px_-18px_rgba(0,0,0,0.55)] transition hover:scale-[1.04] hover:bg-white min-[900px]:flex min-[1480px]:-right-16"
                    type="button"
                    aria-label="Next portfolio spread"
                    data-carousel-next
                >
                    <svg
                        class="h-5 w-5"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        aria-hidden="true"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M9 5l7 7-7 7"></path>
                    </svg>
                </button>
            </div>

            <div
                class="mt-5 hidden items-center justify-center gap-3 lg:flex"
                aria-label="Portfolio spread selector"
            >
                {
                    spreads.map((_, index) => (
                        <button
                            class="h-2.5 w-2.5 rounded-full bg-black/25 transition-colors aria-current:bg-[var(--color-primary)]"
                            type="button"
                            aria-label={`Show portfolio spread ${index + 1}`}
                            aria-current={index === 0 ? "true" : "false"}
                            data-carousel-dot={index}
                        />
                    ))
                }
            </div>

            <div
                class="-mx-4 snap-x snap-mandatory overflow-x-auto overscroll-x-contain px-[6vw] pb-3 [scroll-padding-inline:6vw] lg:hidden"
            >
                <div class="flex gap-4">
                    {
                        portfolioItems.map((item, index) => (
                            <article class="flex w-[88vw] shrink-0 snap-center scroll-ml-[6vw] scroll-mr-[6vw] flex-col bg-white p-4 shadow-[0_18px_50px_-34px_rgba(0,0,0,0.55)] ring-1 ring-black/10">
                                <img
                                    class="aspect-[1.08/1] w-full rounded-[var(--radius-sm)] bg-[var(--color-surface-container)] object-cover"
                                    src={item.image.src}
                                    alt={item.image.alt}
                                    loading={index === 0 ? "eager" : "lazy"}
                                    fetchpriority={
                                        index === 0 ? "high" : "auto"
                                    }
                                />
                                {item.kind === "home" ? (
                                    <>
                                        <div class="mt-5 border-b border-black/65 pb-4">
                                            <p class="text-[0.68rem] font-bold uppercase tracking-[0.13em] text-black">
                                                {item.neighborhood}
                                            </p>
                                            <h2 class="mt-2 text-[1.9rem] font-light leading-none text-black">
                                                {item.title}
                                            </h2>
                                        </div>
                                        <dl class="mt-4 grid grid-cols-4 divide-x divide-black/35">
                                            {item.stats.slice(0, 4).map((stat) => (
                                                <div class="min-w-0 px-1.5 text-center first:pl-0 last:pr-0">
                                                    <dd class="min-h-[1.4rem] [overflow-wrap:anywhere] text-[1.1rem] font-light leading-none text-black">
                                                        {stat.value}
                                                    </dd>
                                                    <dt class="mx-auto mt-2 max-w-[4.7rem] text-[0.45rem] font-bold uppercase leading-tight text-black/85">
                                                        {stat.label}
                                                    </dt>
                                                </div>
                                            ))}
                                        </dl>
                                    </>
                                ) : (
                                    <>
                                        <div class="mt-5 border-b border-black/65 pb-4">
                                            <p class="text-[0.68rem] font-bold uppercase tracking-[0.13em] text-black">
                                                Start Your Project
                                            </p>
                                            <h2 class="mt-2 text-[1.9rem] font-light leading-none text-black">
                                                {item.title}
                                            </h2>
                                        </div>
                                        <div class="mt-4 flex min-h-[7rem] flex-col gap-3">
                                            <p class="[overflow-wrap:anywhere] text-center text-base font-semibold leading-tight text-[var(--color-primary)]">
                                                {config.hero.email}
                                            </p>
                                            <div class="grid grid-cols-2 gap-3">
                                                <a
                                                    href={`mailto:${config.hero.email}`}
                                                    class="btn-primary justify-center px-4 py-3 text-sm"
                                                    aria-label={`Send email to ${config.hero.email}`}
                                                >
                                                    <svg
                                                        class="h-4 w-4"
                                                        fill="none"
                                                        stroke="currentColor"
                                                        viewBox="0 0 24 24"
                                                        aria-hidden="true"
                                                    >
                                                        <path
                                                            stroke-linecap="round"
                                                            stroke-linejoin="round"
                                                            stroke-width="2"
                                                            d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                                                        />
                                                    </svg>
                                                    <span>Email</span>
                                                </a>
                                                <button
                                                    class="btn-secondary justify-center px-4 py-3 text-sm"
                                                    type="button"
                                                    aria-label={`Copy ${config.hero.email} to clipboard`}
                                                    data-copy-email={config.hero.email}
                                                >
                                                    <span data-copy-default class="inline-flex items-center gap-2">
                                                        <svg
                                                            class="h-4 w-4"
                                                            fill="none"
                                                            stroke="currentColor"
                                                            viewBox="0 0 24 24"
                                                            aria-hidden="true"
                                                        >
                                                            <path
                                                                stroke-linecap="round"
                                                                stroke-linejoin="round"
                                                                stroke-width="2"
                                                                d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"
                                                            />
                                                        </svg>
                                                        <span>Copy</span>
                                                    </span>
                                                    <span data-copy-success hidden class="inline-flex items-center gap-2">
                                                        <svg
                                                            class="h-4 w-4 text-[var(--color-primary-container)]"
                                                            fill="none"
                                                            stroke="currentColor"
                                                            viewBox="0 0 24 24"
                                                            aria-hidden="true"
                                                        >
                                                            <path
                                                                stroke-linecap="round"
                                                                stroke-linejoin="round"
                                                                stroke-width="2"
                                                                d="M5 13l4 4L19 7"
                                                            />
                                                        </svg>
                                                        <span>Copied</span>
                                                    </span>
                                                </button>
                                            </div>
                                        </div>
                                    </>
                                )}
                            </article>
                        ))
                    }
                </div>
            </div>
        </section>
    </main>

    <script>
        const track = document.querySelector(
            "[data-carousel-track]",
        ) as HTMLElement | null;
        const prev = document.querySelector(
            "[data-carousel-prev]",
        ) as HTMLButtonElement | null;
        const next = document.querySelector(
            "[data-carousel-next]",
        ) as HTMLButtonElement | null;
        const dots = Array.from(
            document.querySelectorAll("[data-carousel-dot]"),
        ) as HTMLButtonElement[];
        const images = Array.from(
            document.querySelectorAll("[data-carousel-image]"),
        ) as HTMLImageElement[];
        const copyButtons = Array.from(
            document.querySelectorAll("[data-copy-email]"),
        ) as HTMLButtonElement[];

        copyButtons.forEach((button) => {
            const defaultState = button.querySelector("[data-copy-default]");
            const successState = button.querySelector("[data-copy-success]");

            if (!defaultState || !successState) return;

            button.addEventListener("click", async () => {
                const email = button.dataset.copyEmail;
                if (!email) return;

                try {
                    await navigator.clipboard.writeText(email);
                    (defaultState as HTMLElement).hidden = true;
                    (successState as HTMLElement).hidden = false;

                    setTimeout(() => {
                        (defaultState as HTMLElement).hidden = false;
                        (successState as HTMLElement).hidden = true;
                    }, 2000);
                } catch (err) {
                    console.error("Failed to copy:", err);
                }
            });
        });

        if (track && prev && next && dots.length) {
            let current = 0;
            const total = dots.length;
            const preloaded = new Set<string>();

            const preloadSpread = (index: number) => {
                images
                    .filter((image) => image.dataset.spreadIndex === `${index}`)
                    .forEach((image) => {
                        if (preloaded.has(image.src)) return;

                        const preload = new Image();
                        preload.decoding = "async";
                        preload.src = image.src;
                        preloaded.add(image.src);
                    });
            };

            const updateCarousel = () => {
                track.style.transform = `translateX(-${current * 100}%)`;
                dots.forEach((dot, index) => {
                    dot.setAttribute(
                        "aria-current",
                        index === current ? "true" : "false",
                    );
                });
                preloadSpread((current + 1) % total);
            };

            prev.addEventListener("click", () => {
                current = (current - 1 + total) % total;
                updateCarousel();
            });

            next.addEventListener("click", () => {
                current = (current + 1) % total;
                updateCarousel();
            });

            dots.forEach((dot, index) => {
                dot.addEventListener("click", () => {
                    current = index;
                    updateCarousel();
                });
            });

            document.addEventListener("keydown", (event) => {
                const target = event.target as HTMLElement | null;
                const isTyping =
                    target?.matches("input, textarea, select, [contenteditable='true']") ??
                    false;

                if (isTyping) return;

                if (event.key === "ArrowLeft") {
                    event.preventDefault();
                    current = (current - 1 + total) % total;
                    updateCarousel();
                }

                if (event.key === "ArrowRight") {
                    event.preventDefault();
                    current = (current + 1) % total;
                    updateCarousel();
                }
            });

            preloadSpread(1 % total);
        }
    </script>
</Layout>
