---
const headingFonts = [
	{ id: 'cormorant-garamond', name: 'Cormorant Garamond', category: 'Serif' },
	{ id: 'eb-garamond', name: 'EB Garamond', category: 'Serif' },
	{ id: 'playfair-display', name: 'Playfair Display', category: 'Serif' },
	{ id: 'spectral', name: 'Spectral', category: 'Serif' },
	{ id: 'crimson-pro', name: 'Crimson Pro', category: 'Serif' },
	{ id: 'dm-serif-display', name: 'DM Serif Display', category: 'Serif' },
	{ id: 'lora', name: 'Lora', category: 'Serif' },
	{ id: 'libre-baskerville', name: 'Libre Baskerville', category: 'Serif' },
	{ id: 'prata', name: 'Prata', category: 'Serif' },
	{ id: 'tenor-sans', name: 'Tenor Sans', category: 'Serif' },
	{ id: 'geist', name: 'Geist', category: 'Serif' },
	{ id: 'merriweather', name: 'Merriweather', category: 'Serif' },
	{ id: 'cardo', name: 'Cardo', category: 'Serif' },
	{ id: 'cinzel', name: 'Cinzel', category: 'Serif' },
	{ id: 'abril-fatface', name: 'Abril Fatface', category: 'Serif' },
	{ id: 'poppins', name: 'Poppins', category: 'Sans Serif' },
	{ id: 'montserrat', name: 'Montserrat', category: 'Sans Serif' },
	{ id: 'sora', name: 'Sora', category: 'Sans Serif' },
	{ id: 'manrope', name: 'Manrope', category: 'Sans Serif' },
	{ id: 'space-grotesk', name: 'Space Grotesk', category: 'Sans Serif' },
	{ id: 'grotesk', name: 'Grotesk', category: 'Sans Serif' }
];

const bodyFonts = [
	{ id: 'raleway', name: 'Raleway', category: 'Sans Serif' },
	{ id: 'inter', name: 'Inter', category: 'Sans Serif' },
	{ id: 'ibm-plex-sans', name: 'IBM Plex Sans', category: 'Sans Serif' },
	{ id: 'manrope', name: 'Manrope', category: 'Sans Serif' },
	{ id: 'montserrat', name: 'Montserrat', category: 'Sans Serif' },
	{ id: 'nunito-sans', name: 'Nunito Sans', category: 'Sans Serif' },
	{ id: 'geist-grotesk', name: 'Geist Grotesk', category: 'Sans Serif' }
];
---

<div id="font-switcher" class="fixed bottom-4 right-4 z-50">
	<button
		id="font-toggle"
		class="bg-stone-900/90 backdrop-blur-md text-white/80 hover:text-white px-4 py-2.5 rounded-xl shadow-lg hover:bg-stone-800/90 transition-all text-sm flex items-center gap-2 border border-white/10 hover:border-white/20"
		aria-label="Change fonts"
	>
		<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
			<path stroke-linecap="round" stroke-linejoin="round" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129" />
		</svg>
		<span>Fonts</span>
	</button>

	<div
		id="font-panel"
		class="hidden absolute bottom-full right-0 mb-3 bg-stone-900/95 backdrop-blur-xl rounded-xl shadow-2xl border border-white/10 w-80"
	>
		<div class="p-4 border-b border-white/10 flex justify-between items-center">
			<h3 class="text-sm font-medium text-white">Choose Fonts</h3>
			<button
				id="random-fonts"
				class="text-xs bg-white/10 hover:bg-white/20 text-white/80 px-3 py-1.5 rounded-lg transition-colors flex items-center gap-1"
			>
				<svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
					<path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
				</svg>
				Random
			</button>
		</div>

		<div class="p-4 space-y-4">
			<div class="relative">
				<div class="flex items-center justify-between mb-2">
					<label class="text-xs font-medium text-white/60">Heading Font</label>
					<button
						id="lock-heading"
						class="text-white/40 hover:text-white/60 transition-colors p-1"
						data-locked="false"
					>
						<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
							<path stroke-linecap="round" stroke-linejoin="round" d="M8 11V7a4 4 0 118 0m-4 8v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2z" />
						</svg>
					</button>
				</div>
				<div id="heading-dropdown" class="relative">
					<button
						id="heading-trigger"
						class="w-full px-3 py-2.5 bg-white/5 border border-white/10 rounded-lg text-sm text-white focus:outline-none focus:ring-2 focus:ring-[var(--color-accent)]/50 focus:border-transparent text-left flex justify-between items-center hover:bg-white/10 transition-colors"
					>
						<span id="heading-selected" style="font-family: 'Space Grotesk', sans-serif; font-weight: 700;">Space Grotesk</span>
						<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-white/40" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
							<path stroke-linecap="round" stroke-linejoin="round" d="M5 15l7-7 7 7" />
						</svg>
					</button>
				</div>
			</div>

			<div class="relative">
				<div class="flex items-center justify-between mb-2">
					<label class="text-xs font-medium text-white/60">Body Font</label>
					<button
						id="lock-body"
						class="text-white/40 hover:text-white/60 transition-colors p-1"
						data-locked="false"
					>
						<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
							<path stroke-linecap="round" stroke-linejoin="round" d="M8 11V7a4 4 0 118 0m-4 8v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2z" />
						</svg>
					</button>
				</div>
				<div id="body-dropdown" class="relative">
					<button
						id="body-trigger"
						class="w-full px-3 py-2.5 bg-white/5 border border-white/10 rounded-lg text-sm text-white focus:outline-none focus:ring-2 focus:ring-[var(--color-accent)]/50 focus:border-transparent text-left flex justify-between items-center hover:bg-white/10 transition-colors"
					>
						<span id="body-selected" style="font-family: 'Space Grotesk', sans-serif;">Space Grotesk</span>
						<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-white/40" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
							<path stroke-linecap="round" stroke-linejoin="round" d="M5 15l7-7 7 7" />
						</svg>
					</button>
				</div>
			</div>
		</div>
	</div>
</div>

<div id="heading-options" class="hidden fixed bg-stone-900/95 backdrop-blur-xl border border-white/10 rounded-lg shadow-xl max-h-60 overflow-y-auto z-[60] w-[320px]">
	{headingFonts.map((font) => (
		<button
			class="w-full px-3 py-2.5 text-left text-sm text-white/80 hover:text-white hover:bg-white/10 transition-colors"
			data-font-id={font.id}
			data-font-name={font.name}
		>
			{font.name}
		</button>
	))}
</div>

<div id="body-options" class="hidden fixed bg-stone-900/95 backdrop-blur-xl border border-white/10 rounded-lg shadow-xl max-h-60 overflow-y-auto z-[60] w-[320px]">
	{bodyFonts.map((font) => (
		<button
			class="w-full px-3 py-2.5 text-left text-sm text-white/80 hover:text-white hover:bg-white/10 transition-colors"
			data-font-id={font.id}
			data-font-name={font.name}
		>
			{font.name}
		</button>
	))}
</div>

<script define:vars={{ headingFonts, bodyFonts }}>
	(function() {
		const toggle = document.getElementById('font-toggle');
		const panel = document.getElementById('font-panel');
		const headingTrigger = document.getElementById('heading-trigger');
		const headingOptions = document.getElementById('heading-options');
		const headingSelected = document.getElementById('heading-selected');
		const bodyTrigger = document.getElementById('body-trigger');
		const bodyOptions = document.getElementById('body-options');
		const bodySelected = document.getElementById('body-selected');
		const lockHeadingBtn = document.getElementById('lock-heading');
		const lockBodyBtn = document.getElementById('lock-body');
		const randomBtn = document.getElementById('random-fonts');
		let isOpen = false;

		const headingFontMap = Object.fromEntries(headingFonts.map(f => [f.id, f.name]));
		const bodyFontMap = Object.fromEntries(bodyFonts.map(f => [f.id, f.name]));

		const lockedIcon = `<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
			<path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
		</svg>`;

		const unlockedIcon = `<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
			<path stroke-linecap="round" stroke-linejoin="round" d="M8 11V7a4 4 0 118 0m-4 8v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2z" />
		</svg>`;

		toggle.addEventListener('click', () => {
			isOpen = !isOpen;
			panel.classList.toggle('hidden', !isOpen);
		});

		document.addEventListener('click', (e) => {
			if (!e.target.closest('#font-switcher') && isOpen) {
				isOpen = false;
				panel.classList.add('hidden');
				closeAllDropdowns();
			}
		});

		function closeAllDropdowns() {
			headingOptions.classList.add('hidden');
			bodyOptions.classList.add('hidden');
		}

		headingTrigger.addEventListener('click', (e) => {
			e.stopPropagation();
			const isHidden = headingOptions.classList.contains('hidden');
			closeAllDropdowns();
			if (isHidden) {
				const rect = headingTrigger.getBoundingClientRect();
				headingOptions.style.top = `${rect.top - 4}px`;
				headingOptions.style.right = `${window.innerWidth - rect.right}px`;
				headingOptions.classList.remove('hidden');
			}
		});

		bodyTrigger.addEventListener('click', (e) => {
			e.stopPropagation();
			const isHidden = bodyOptions.classList.contains('hidden');
			closeAllDropdowns();
			if (isHidden) {
				const rect = bodyTrigger.getBoundingClientRect();
				bodyOptions.style.top = `${rect.top - 4}px`;
				bodyOptions.style.right = `${window.innerWidth - rect.right}px`;
				bodyOptions.classList.remove('hidden');
			}
		});

		headingOptions.querySelectorAll('button').forEach(btn => {
			const fontId = btn.dataset.fontId;
			const fontName = btn.dataset.fontName;
			const font = headingFonts.find(f => f.id === fontId);
			const isSerif = font && ['eb-garamond', 'cormorant-garamond', 'playfair-display', 'spectral', 'crimson-pro', 'dm-serif-display', 'lora', 'libre-baskerville', 'prata', 'tenor-sans', 'bodoni-moda', 'merriweather', 'cardo', 'cinzel', 'abril-fatface'].includes(fontId);
			const fontFamily = isSerif ? `'${fontName}', serif` : `'${fontName}', sans-serif`;
			btn.style.fontFamily = fontFamily;

			btn.addEventListener('click', (e) => {
				e.stopPropagation();
				headingSelected.textContent = fontName;
				headingSelected.style.fontFamily = fontFamily;
				applyHeadingFont(fontId);
				localStorage.setItem('qbuilders-heading-font', fontId);
				closeAllDropdowns();
			});
		});

		bodyOptions.querySelectorAll('button').forEach(btn => {
			const fontId = btn.dataset.fontId;
			const fontName = btn.dataset.fontName;
			const fontFamily = `'${fontName}', sans-serif`;
			btn.style.fontFamily = fontFamily;

			btn.addEventListener('click', (e) => {
				e.stopPropagation();
				bodySelected.textContent = fontName;
				bodySelected.style.fontFamily = fontFamily;
				applyBodyFont(fontId);
				localStorage.setItem('qbuilders-body-font', fontId);
				closeAllDropdowns();
			});
		});

		const savedHeading = localStorage.getItem('qbuilders-heading-font');
		const savedBody = localStorage.getItem('qbuilders-body-font');
		const savedLockHeading = localStorage.getItem('qbuilders-lock-heading') === 'true';
		const savedLockBody = localStorage.getItem('qbuilders-lock-body') === 'true';

		if (savedHeading) {
			const fontName = headingFontMap[savedHeading];
			headingSelected.textContent = fontName;
			const font = headingFonts.find(f => f.id === savedHeading);
			const isSerif = font && ['eb-garamond', 'cormorant-garamond', 'playfair-display', 'spectral', 'crimson-pro', 'dm-serif-display', 'lora', 'libre-baskerville', 'prata', 'tenor-sans', 'bodoni-moda', 'merriweather', 'cardo', 'cinzel', 'abril-fatface'].includes(savedHeading);
			const fontFamily = isSerif ? `'${fontName}', serif` : `'${fontName}', sans-serif`;
			headingSelected.style.fontFamily = fontFamily;
			applyHeadingFont(savedHeading);
		}

		if (savedBody) {
			const fontName = bodyFontMap[savedBody];
			bodySelected.textContent = fontName;
			const fontFamily = `'${fontName}', sans-serif`;
			bodySelected.style.fontFamily = fontFamily;
			applyBodyFont(savedBody);
		}

		if (savedLockHeading) {
			lockHeadingBtn.dataset.locked = 'true';
			lockHeadingBtn.innerHTML = lockedIcon;
			lockHeadingBtn.classList.remove('text-stone-400');
			lockHeadingBtn.classList.add('text-amber-500');
		}

		if (savedLockBody) {
			lockBodyBtn.dataset.locked = 'true';
			lockBodyBtn.innerHTML = lockedIcon;
			lockBodyBtn.classList.remove('text-stone-400');
			lockBodyBtn.classList.add('text-amber-500');
		}

		lockHeadingBtn.addEventListener('click', (e) => {
			e.stopPropagation();
			const isLocked = lockHeadingBtn.dataset.locked === 'true';
			lockHeadingBtn.dataset.locked = (!isLocked).toString();

			if (!isLocked) {
				lockHeadingBtn.innerHTML = lockedIcon;
				lockHeadingBtn.classList.remove('text-stone-400');
				lockHeadingBtn.classList.add('text-amber-500');
				localStorage.setItem('qbuilders-lock-heading', 'true');
			} else {
				lockHeadingBtn.innerHTML = unlockedIcon;
				lockHeadingBtn.classList.remove('text-amber-500');
				lockHeadingBtn.classList.add('text-stone-400');
				localStorage.setItem('qbuilders-lock-heading', 'false');
			}
		});

		lockBodyBtn.addEventListener('click', (e) => {
			e.stopPropagation();
			const isLocked = lockBodyBtn.dataset.locked === 'true';
			lockBodyBtn.dataset.locked = (!isLocked).toString();

			if (!isLocked) {
				lockBodyBtn.innerHTML = lockedIcon;
				lockBodyBtn.classList.remove('text-stone-400');
				lockBodyBtn.classList.add('text-amber-500');
				localStorage.setItem('qbuilders-lock-body', 'true');
			} else {
				lockBodyBtn.innerHTML = unlockedIcon;
				lockBodyBtn.classList.remove('text-amber-500');
				lockBodyBtn.classList.add('text-stone-400');
				localStorage.setItem('qbuilders-lock-body', 'false');
			}
		});

		randomBtn.addEventListener('click', () => {
			const headingLocked = lockHeadingBtn.dataset.locked === 'true';
			const bodyLocked = lockBodyBtn.dataset.locked === 'true';

			if (!headingLocked) {
				const randomHeading = headingFonts[Math.floor(Math.random() * headingFonts.length)];
				headingSelected.textContent = randomHeading.name;
				const isSerif = ['eb-garamond', 'cormorant-garamond', 'playfair-display', 'spectral', 'crimson-pro', 'dm-serif-display', 'lora', 'libre-baskerville', 'prata', 'tenor-sans', 'bodoni-moda', 'merriweather', 'cardo', 'cinzel', 'abril-fatface'].includes(randomHeading.id);
				const fontFamily = isSerif ? `'${randomHeading.name}', serif` : `'${randomHeading.name}', sans-serif`;
				headingSelected.style.fontFamily = fontFamily;
				applyHeadingFont(randomHeading.id);
				localStorage.setItem('qbuilders-heading-font', randomHeading.id);
			}

			if (!bodyLocked) {
				const randomBody = bodyFonts[Math.floor(Math.random() * bodyFonts.length)];
				bodySelected.textContent = randomBody.name;
				const fontFamily = `'${randomBody.name}', sans-serif`;
				bodySelected.style.fontFamily = fontFamily;
				applyBodyFont(randomBody.id);
				localStorage.setItem('qbuilders-body-font', randomBody.id);
			}
		});

		function applyHeadingFont(fontId) {
			const fontName = headingFontMap[fontId];
			const isSerif = ['eb-garamond', 'cormorant-garamond', 'playfair-display', 'spectral', 'crimson-pro', 'dm-serif-display', 'lora', 'libre-baskerville', 'prata', 'tenor-sans', 'bodoni-moda', 'merriweather', 'cardo', 'cinzel', 'abril-fatface'].includes(fontId);
			const fontFamily = `'${fontName}', ${isSerif ? 'serif' : 'sans-serif'}`;
			document.documentElement.style.setProperty('--font-heading', fontFamily);
		}

		function applyBodyFont(fontId) {
			const fontName = bodyFontMap[fontId];
			const fontFamily = `'${fontName}', sans-serif`;
			document.documentElement.style.setProperty('--font-body', fontFamily);
		}
	})();
</script>
